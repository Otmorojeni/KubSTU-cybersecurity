Py = 61284794136931225887168223125830152379474204858165162385258610873699465911316;

E = ellinit([c1, c2, c3, c4, c6] * Mod(1, p));
G = [Gx, Gy] * Mod(1, p);
P = [Px, Py] * Mod(1, p);

card = 115792089237316196275616121189559184590348384834999899509856666154073434105098;

\\ Check mod 7:
m7 = card / 7;
G7 = ellmul(E, G, m7);
P7 = ellmul(E, P, m7);
k7 = elllog(E, P7, G7, 7);
print("k mod 7 = ", k7);

\\ Check mod 53:
m53 = card / 53;
G53 = ellmul(E, G, m53);
P53 = ellmul(E, P, m53);
k53 = elllog(E, P53, G53, 53);
print("k mod 53 = ", k53);

\\ Check mod 445948132477:
m39 = card / 445948132477;
G39 = ellmul(E, G, m39);
P39 = ellmul(E, P, m39);
